[Unit]
Description=Nexus Saga backend (docker compose up)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/mnt/c/Users/US3R/photon-backend
# Tunggu /mnt/c (Windows FS) ter-mount saat boot sebelum compose up.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -f /mnt/c/Users/US3R/photon-backend/docker-compose.yml ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
