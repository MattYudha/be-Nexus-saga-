# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=pong
POSTGRES_USER=pong
POSTGRES_PASSWORD=change-me

# openssl rand -base64 48
JWT_SECRET=
# Must match "WebHookSecret" in the Photon dashboard (sent as the X-SecretKey header).
PHOTON_WEBHOOK_SECRET=
# Appended as ?secret=... to the Photon custom authentication URL.
PHOTON_AUTH_SECRET=

# Only used with `--profile tls` (Caddy). DNS A/AAAA record must point to this server.
API_DOMAIN=api.example.com
API_PORT=8080

# Image used by the release bundle (docker-compose.yml from a GitHub Release). Ignored by the source checkout.
# API_IMAGE=ghcr.io/cds-id/photon-backend-api:latest
